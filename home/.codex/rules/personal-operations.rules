# Personal command approval boundaries. Exact prefixes; not a complete API/script policy.
# Source: https://learn.chatgpt.com/docs/agent-configuration/rules
prefix_rule(pattern=["git", "push"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["git push"])
prefix_rule(pattern=["gh", "pr", "create"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["gh pr create"])
prefix_rule(pattern=["gh", "pr", "comment"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["gh pr comment"])
prefix_rule(pattern=["gh", "pr", "review"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["gh pr review"])
prefix_rule(pattern=["gh", "pr", "merge"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["gh pr merge"])
prefix_rule(pattern=["gh", "issue", "comment"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["gh issue comment"])
prefix_rule(pattern=["terraform", "apply"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["terraform apply"])
prefix_rule(pattern=["terraform", "destroy"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["terraform destroy"])
prefix_rule(pattern=["terraform", "import"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["terraform import"])
prefix_rule(pattern=["terraform", "state", "rm"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["terraform state rm"])
prefix_rule(pattern=["terraform", "state", "mv"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["terraform state mv"])
prefix_rule(pattern=["terraform", "state", "push"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["terraform state push"])
prefix_rule(pattern=["tofu", "apply"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["tofu apply"])
prefix_rule(pattern=["tofu", "destroy"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["tofu destroy"])
prefix_rule(pattern=["tofu", "import"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["tofu import"])
prefix_rule(pattern=["tofu", "state", "rm"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["tofu state rm"])
prefix_rule(pattern=["tofu", "state", "mv"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["tofu state mv"])
prefix_rule(pattern=["tofu", "state", "push"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["tofu state push"])
prefix_rule(pattern=["kubectl", "apply"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["kubectl apply"])
prefix_rule(pattern=["kubectl", "delete"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["kubectl delete"])
prefix_rule(pattern=["kubectl", "scale"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["kubectl scale"])
prefix_rule(pattern=["kubectl", "rollout", "restart"], decision="prompt", justification="Confirm the requested external or operational change; approval does not replace user authorization.", match=["kubectl rollout restart"])
